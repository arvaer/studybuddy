; The environment one workspace's operator runs under (19c). `{{workspace}}`
; is the workspace id, filled by the host; every domain effect is scoped to
; that workspace's paths. The model is granted, the learner's wait is a park
; nothing answers in-process (20b completes it from the attempt receipt).
(environment studybuddy-learning
  (grant capability call/model :kind model-call)
  (grant capability learning/present :kind tool :scope "workspaces/{{workspace}}/*")
  (grant capability learning/assess :kind tool :scope "workspaces/{{workspace}}/*")
  (grant capability source/read :kind tool :scope "workspaces/{{workspace}}/*")
  (grant capability learning/hint :kind tool :scope "workspaces/{{workspace}}/*")
  (grant capability learner/wait :kind tool :scope "workspaces/{{workspace}}/*")
  ;; The cap on any one effect's outbound payload. The model call carries
  ;; the whole conversation, reads of the source included (21a: up to four
  ;; pages of 4000 characters each), so 16 KB refused the coach's second
  ;; turn after a read; 256 KB is room for a long session, and the context
  ;; policy, when records justify one, is where growth is really governed.
  (require constraint max-bytes :kind structural :rule (rule (max-bytes 262144)))
  (budget :evaluator-steps 200000 :boundary-effects 300))
