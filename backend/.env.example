# Copy to backend/.env and fill in. backend/.env is gitignored.

# Required
DATABASE_URL=postgres://studybuddy:studybuddy@127.0.0.1:55432/studybuddy_dev
# Generate with: openssl rand -base64 48 . Never reuse a value that was ever committed.
JWT_SECRET=

# Optional (defaults shown)
#PORT=3000
#CORS_ORIGIN=http://localhost:8080
#UPLOADS_DIR=data/uploads
#RUST_LOG=lugia=debug,tower_http=debug
#COOKIE_SECURE=true              # false only for plain-http dev if your browser drops Secure cookies on localhost

# Optional model access (unset = AI features off). See docs/development.md.
#LLM_PROVIDER=anthropic          # anthropic | openai
#LLM_API_KEY=
#LLM_MODEL=claude-sonnet-4-5-20250929
#LLM_BASE_URL=                   # default per provider; host must be in LLM_ALLOWED_HOSTS
#LLM_ALLOWED_HOSTS=api.anthropic.com,api.openai.com
#LLM_TIMEOUT_SECS=30

# Operator effect endpoints (19a): the embedded owner presents this bearer
# secret over loopback. Unset, a per-process secret is drawn at startup (20a);
# set it (16+ characters) only when something outside this process calls them.
#OPERATOR_SECRET=

# The operator's model (19b): upstream's Claude adapter in-process, keyed as
# capsule-corp is. Unset, the operator cannot think. OPERATOR_MODEL defaults
# to claude-opus-5-5, the launcher's default.
#ANTHROPIC_API_KEY=
#OPERATOR_MODEL=claude-opus-5-5
