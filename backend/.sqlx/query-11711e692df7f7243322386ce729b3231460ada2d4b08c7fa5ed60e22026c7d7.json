  "query": "\n            SELECT r.id, r.activity_id, r.revision, r.prompt, r.options, r.answer_key, r.rubric\n            FROM activity_revisions r\n            JOIN activities a ON a.id = r.activity_id\n            WHERE r.id = $1 AND a.user_id = $2\n            ",
